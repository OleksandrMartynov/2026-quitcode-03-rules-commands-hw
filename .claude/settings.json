{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-core.mjs\" || exit 2",
            "timeout": 10,
            "statusMessage": "Перевірка захищених шляхів"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-core.mjs\" || exit 2",
            "timeout": 10,
            "statusMessage": "Перевірка захищених шляхів"
          }
        ]
      }
    ]
  }
}
